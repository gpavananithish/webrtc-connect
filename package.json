{
  "name": "connect-webrtc",
  "version": "1.0.0",
  "description": "Standalone WebRTC Real-Time Communication Platform (Native WebRTC APIs, React, Node.js, SQLite)",
  "scripts": {
    "server": "node --watch server/src/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "build:client": "npm --prefix client run build",
    "start": "node server/src/server.js"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}

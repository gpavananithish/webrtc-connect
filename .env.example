# ==============================================================
# Standalone WebRTC Real-Time Communication Platform Environment
# ==============================================================

# Server configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=connect_secret_jwt_key_994827462819_webrtc_platform

# SQLite Database location (relative to server directory or absolute)
DATABASE_PATH=../storage/database.sqlite
STORAGE_DIR=../storage

# WebRTC Network Discovery (STUN / TURN)
# Default public Google STUN server (safe for peer-to-peer discovery)
STUN_SERVER=stun:stun.l.google.com:19302

# Optional Self-Hosted Coturn TURN Server (for Symmetric NAT traversal)
# Leave blank if not using TURN
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Mesh Topology Participant Limit (recommended: 4-6 for P2P mesh)
MAX_MEETING_PARTICIPANTS=6
